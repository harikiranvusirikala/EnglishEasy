# Google Tag Manager container for the landing page (Vercel Production only; leave empty locally)
GTM_ID=

# MongoDB Atlas (Step 18). Databases: englisheasy_dev locally, englisheasy_preview for previews, englisheasy in production.
MONGODB_URI=
MONGODB_DB=englisheasy_dev

# Better Auth (Step 18). Generate a secret with: openssl rand -base64 32 (different in every environment).
BETTER_AUTH_SECRET=
# The app's own address: http://localhost:3000 locally; set in Vercel Production only (previews use Vercel's own hosts).
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth client (Step 18)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only if preview deployments are used: the same value in Production and Preview, so previews sign in through production.
OAUTH_PROXY_SECRET=

# Daily reminders (Step 21). Print a new key pair with: npm run vapid. VAPID_SUBJECT is mailto: the owner's email.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Long random text; the same value in Vercel and in the GitHub repository secrets (the hourly workflow sends it).
REMINDER_SECRET=

# Site stats and feedback at /admin: the owners' Google emails, comma-separated (case, Gmail dots and +tags ignored). Empty: nobody.
SITE_ADMIN_EMAILS=
