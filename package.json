{
  "name": "english-easy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node --import tsx --env-file-if-exists=.env.local scripts/build-content.mts",
    "dev": "next dev",
    "prebuild": "node --import tsx --env-file-if-exists=.env.local scripts/build-content.mts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "db:ping": "node --import tsx --env-file-if-exists=.env.local scripts/db-ping.mts",
    "db:setup": "node --import tsx --env-file-if-exists=.env.local scripts/db-setup.mts",
    "vapid": "node --import tsx scripts/vapid.mts",
    "reports": "node --import tsx --env-file-if-exists=.env.local scripts/reports.mts",
    "images": "node --import tsx scripts/site-images.mts",
    "content": "node --import tsx --env-file-if-exists=.env.local scripts/build-content.mts",
    "audio": "npm install --prefix tools/audio --ignore-scripts --no-audit --no-fund --loglevel=error && node --import tsx scripts/build-audio.mts"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-telugu": "^5.3.0",
    "@types/web-push": "^3.6.4",
    "better-auth": "^1.7.18",
    "mongodb": "^7.8.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
